{
  "name": "biobook-tools",
  "private": true,
  "description": "Nur zum Bündeln des Editors nach web/vendor/tiptap.js (npm run bundle)",
  "scripts": {
    "bundle": "esbuild entry.js --bundle --minify --format=iife --global-name=TT --outfile=../web/vendor/tiptap.js",
    "chem": "cp node_modules/smiles-drawer/dist/smiles-drawer.min.js ../web/vendor/ && cp node_modules/smiles-drawer/LICENSE.md ../web/vendor/smiles-drawer.LICENSE.md"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-mathematics": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "esbuild": "^0.28.2",
    "katex": "^0.16.22",
    "smiles-drawer": "^2.4.1"
  }
}
